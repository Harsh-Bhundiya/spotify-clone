<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>signup</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div id="signuppage">
        <div id="about">
        <img id="logo" src="/images/logo.png" alt="">
        <h2>Sign Up to Spotify</h2>
    </div>
    
    <form action="http://localhost:8080/signup" method="post">
        <div id="container_y">
            <input type="text" name="username" id="username" placeholder="enter your name">
            <input type="email" name="email" id="email" placeholder="enter you email">
            <input type="password" name="password" id="password" placeholder="enter password">
            <label for="profilepic" id="uploadpic">upload your profile picture(optional)</label>
            <input type="file" src="" alt=""  accept="image/*" id="profilepic">
            <button>Submit</button>
        </div>
    </form>
    </div>
</body>
</html>